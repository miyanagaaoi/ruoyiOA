<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.template.mapper.TemplateFlowAdminMapper">

    <!-- 显式 resultMap：不依赖全局 map-underscore-to-camel-case 开关 -->
    <resultMap type="com.ruoyi.template.domain.TemplateFlowAdmin" id="TemplateFlowAdminResult">
        <result property="id"         column="id"/>
        <result property="templateId" column="template_id"/>
        <result property="userId"     column="user_id"/>
        <result property="createId"   column="create_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectVo">
        select id, template_id, user_id, create_id, create_time
        from t_template_flow_admin
    </sql>

    <select id="selectByTemplateId" resultMap="TemplateFlowAdminResult">
        <include refid="selectVo"/>
        where template_id = #{templateId}
        order by create_time
    </select>

    <select id="countByTemplateId" resultType="int">
        select count(*) from t_template_flow_admin where template_id = #{templateId}
    </select>

    <select id="countByTemplateIdAndUserId" resultType="int">
        select count(*) from t_template_flow_admin
        where template_id = #{templateId} and user_id = #{userId}
    </select>

    <delete id="deleteByTemplateId">
        delete from t_template_flow_admin where template_id = #{templateId}
    </delete>

    <insert id="batchInsert">
        insert into t_template_flow_admin
            (id, template_id, user_id, create_id, create_time)
        values
        <foreach collection="list" item="it" separator=",">
            (#{it.id}, #{it.templateId}, #{it.userId}, #{it.createId}, sysdate())
        </foreach>
    </insert>

</mapper>
