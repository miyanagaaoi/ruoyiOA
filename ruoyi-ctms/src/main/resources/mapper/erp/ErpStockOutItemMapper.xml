<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  出库单行项（t_ctms_stock_out_item，22 列）的 Mapper（B4 第 3 组）。

  与 ErpStockInItemMapper.xml 逐列对称（行项全量替换、快照由 ErpMasterGuards 固化、
  warehouse_id 未填时回落表头仓库、时间走 sysdate()），理由见入库行项 Mapper 的头部注释。

  命名硬规则：文件名以 Mapper.xml 结尾，namespace 与接口全限定名一致。
-->
<mapper namespace="com.ruoyi.ctms.erp.posting.mapper.ErpStockOutItemMapper">

    <resultMap type="com.ruoyi.ctms.erp.posting.domain.ErpStockOutItem" id="ErpStockOutItemResult">
        <id     property="id"            column="id"             />
        <result property="docId"         column="doc_id"         />
        <result property="seq"           column="seq"            />
        <result property="productId"     column="product_id"     />
        <result property="productCode"   column="product_code"   />
        <result property="productName"   column="product_name"   />
        <result property="spec"          column="spec"           />
        <result property="uomName"       column="uom_name"       />
        <result property="uomDecimals"   column="uom_decimals"   />
        <result property="qty"           column="qty"            />
        <result property="unitPrice"     column="unit_price"     />
        <result property="amount"        column="amount"         />
        <result property="warehouseId"   column="warehouse_id"   />
        <result property="warehouseName" column="warehouse_name" />
        <result property="srcItemId"     column="src_item_id"    />
        <result property="remark"        column="remark"         />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createId"      column="create_id"      />
        <result property="createBy"      column="create_by"      />
        <result property="updateId"      column="update_id"      />
        <result property="updateBy"      column="update_by"      />
    </resultMap>

    <sql id="selectStockOutItemVo">
        select id, doc_id, seq, product_id, product_code, product_name, spec, uom_name, uom_decimals,
               qty, unit_price, amount, warehouse_id, warehouse_name, src_item_id, remark,
               create_time, update_time, create_id, create_by, update_id, update_by
          from t_ctms_stock_out_item
    </sql>

    <select id="selectItemsByDocId" resultMap="ErpStockOutItemResult">
        <include refid="selectStockOutItemVo"/>
         where doc_id = #{docId}
         order by seq, id
    </select>

    <insert id="batchInsertItems">
        insert into t_ctms_stock_out_item(
            id, doc_id, seq, product_id, product_code, product_name, spec, uom_name, uom_decimals,
            qty, unit_price, amount, warehouse_id, warehouse_name, src_item_id, remark,
            create_time, update_time, create_id, create_by
        )values
        <foreach collection="items" item="item" separator=",">
            (
            #{item.id}, #{item.docId}, #{item.seq}, #{item.productId}, #{item.productCode},
            #{item.productName}, #{item.spec}, #{item.uomName}, #{item.uomDecimals},
            #{item.qty}, #{item.unitPrice}, #{item.amount}, #{item.warehouseId}, #{item.warehouseName},
            #{item.srcItemId}, #{item.remark}, sysdate(), sysdate(), #{item.createId}, #{item.createBy}
            )
        </foreach>
    </insert>

    <delete id="deleteItemsByDocId">
        delete from t_ctms_stock_out_item where doc_id = #{docId}
    </delete>

</mapper>
